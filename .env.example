# WEIR Deployment & Relayer Configuration
# Copy to .env and fill in your funded private key

# Hex-encoded private key for deployment and test execution (needs Sepolia ETH and Creditcoin CC3 CTC)
PRIVATE_KEY=your_private_key_here

# Network RPC Endpoints
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network

# Attestcoin Proof Builder API
PROVER_URL=https://prover.cc3-testnet.creditcoin.network
